            "formatString": "0"
          },
          {
            "name": "emploi",
            "dataType": "int64",
            "sourceColumn": "emploi",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0"
          },
          {
            "name": "recherche_emploi",
            "dataType": "int64",
            "sourceColumn": "recherche_emploi",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0"
          },
          {
            "name": "etudes",
            "dataType": "int64",
            "sourceColumn": "etudes",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0"
          },
          {
            "name": "inactif",
            "dataType": "int64",
            "sourceColumn": "inactif",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0"
          },
          {
            "name": "actifs",
            "dataType": "int64",
            "sourceColumn": "actifs",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0"
          },
          {
            "name": "non_reponse",
            "dataType": "int64",
            "sourceColumn": "non_reponse",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0"
          },
          {
