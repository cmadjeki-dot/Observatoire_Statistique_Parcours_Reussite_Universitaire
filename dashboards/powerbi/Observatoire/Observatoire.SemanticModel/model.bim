{
  "name": "Observatoire",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "fr-FR",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "fr-FR",
    "tables": [
      {
        "name": "DimFormation",
        "columns": [
          {
            "name": "formation_id",
            "dataType": "string",
            "sourceColumn": "formation_id",
            "summarizeBy": "none"
          },
          {
            "name": "libelle_fictif",
            "dataType": "string",
            "sourceColumn": "libelle_fictif",
            "summarizeBy": "none"
          },
          {
            "name": "composante_fictive",
            "dataType": "string",
            "sourceColumn": "composante_fictive",
            "summarizeBy": "none"
          },
          {
            "name": "cycle",
            "dataType": "string",
            "sourceColumn": "cycle",
            "summarizeBy": "none"
          },
          {
            "name": "niveau_terminal",
            "dataType": "int64",
            "sourceColumn": "niveau_terminal",
            "summarizeBy": "none",
            "formatString": "0"
          }
        ],
        "partitions": [
          {
            "name": "DimFormation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "fxCsv(\"dim_formation.csv\", {\"formation_id\", \"libelle_fictif\", \"composante_fictive\", \"cycle\"}, false)"
            }
          }
        ]
      },
      {
        "name": "DimAnnee",
        "columns": [
          {
            "name": "annee",
            "dataType": "string",
            "sourceColumn": "annee",
            "summarizeBy": "none",
            "sortByColumn": "ordre"
          },
          {
            "name": "ordre",
            "dataType": "int64",
            "sourceColumn": "ordre",
            "summarizeBy": "none",
            "formatString": "0"
          }
        ],
        "partitions": [
          {
            "name": "DimAnnee",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "fxCsv(\"dim_annee.csv\", {\"annee\"}, false)"
            }
          }
        ]
      },
      {
        "name": "DimAnneeGraph",
        "columns": [
          {
            "name": "annee",
            "dataType": "string",
            "sourceColumn": "annee",
            "summarizeBy": "none",
            "sortByColumn": "ordre"
          },
          {
            "name": "ordre",
            "dataType": "int64",
            "sourceColumn": "ordre",
            "summarizeBy": "none",
            "formatString": "0"
          }
        ],
        "partitions": [
          {
            "name": "DimAnneeGraph",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "fxCsv(\"dim_annee.csv\", {\"annee\"}, false)"
            }
          }
        ]
      },
