    "expressions": [
      {
        "name": "DossierExports",
        "kind": "m",
        "expression": "\"C:/Users/admin/Desktop/Observatoire_Statistique_Parcours_Reussite_Universitaire/dashboards/powerbi/Observatoire/Data/\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "fxCsv",
        "kind": "m",
        "expression": "(nom as text, textes as list, optional masque as nullable logical) as table =>\nlet\n    Source = Csv.Document(File.Contents(DossierExports & nom),\n        [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    Vides = Table.ReplaceValue(Entetes, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Entetes)),\n    Numeriques = List.Difference(Table.ColumnNames(Vides), textes),\n    TypesNumeriques = List.Transform(Numeriques, each {_, Int64.Type}),\n    TypesTexte = List.Transform(List.RemoveItems(textes, {\"masque\"}), each {_, type text}),\n    Types = Table.TransformColumnTypes(Vides, TypesNumeriques & TypesTexte, \"en-US\"),\n    Resultat = if masque = true then\n        Table.TransformColumns(Types, {{\"masque\", each if _ = null then error \"Masque absent\"\n            else if Text.Upper(_) = \"TRUE\" then true\n            else if Text.Upper(_) = \"FALSE\" then false\n            else error \"Masque invalide\", type logical}})\n        else Types\nin\n    Resultat"
      }
    ],
    "annotations": [
      {
        "name": "PBI_ProTooling",
        "value": "[\"DevMode\"]"
      }
    ]
