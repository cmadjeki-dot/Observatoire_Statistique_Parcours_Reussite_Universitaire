          }
        ],
        "partitions": [
          {
            "name": "FactInsertion",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "fxCsv(\"fait_insertion.csv\", {\"annee\", \"formation_id\", \"masque\"}, true)"
            }
          }
        ]
      },
      {
        "name": "Indicateurs",
        "columns": [
          {
            "name": "vide",
            "dataType": "int64",
            "sourceColumn": "vide",
            "isHidden": true
          }
        ],
        "measures": [
          {
            "name": "Scolarite masquee",
            "expression": "COUNTROWS(FILTER(FactScolarite, FactScolarite[masque] = TRUE())) > 0",
            "displayFolder": "Diagnostic",
            "isHidden": true
          },
          {
            "name": "Evaluation masquee",
            "expression": "COUNTROWS(FILTER(FactEvaluation, FactEvaluation[masque] = TRUE())) > 0",
            "displayFolder": "Diagnostic",
            "isHidden": true
          },
          {
            "name": "Insertion masquee",
            "expression": "COUNTROWS(FILTER(FactInsertion, FactInsertion[masque] = TRUE())) > 0",
            "displayFolder": "Diagnostic",
            "isHidden": true
          },
          {
            "name": "Inscrits",
            "expression": "IF(HASONEVALUE(DimAnnee[annee]) && NOT([Scolarite masquee]), SUM(FactScolarite[inscrits]), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "#,0"
          },
          {
            "name": "Inscriptions annuelles cumulees",
            "expression": "IF(NOT([Scolarite masquee]), SUM(FactScolarite[inscrits]), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "#,0"
          },
          {
            "name": "Validation eligibles",
            "expression": "IF(NOT([Scolarite masquee]), DIVIDE(SUM(FactScolarite[validations]), SUM(FactScolarite[inscrits])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Couverture resultats",
            "expression": "IF(NOT([Scolarite masquee]), DIVIDE(SUM(FactScolarite[connus]), SUM(FactScolarite[inscrits])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Validation connus",
            "expression": "IF(NOT([Scolarite masquee]), DIVIDE(SUM(FactScolarite[validations]), SUM(FactScolarite[connus])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Validation borne haute",
            "expression": "IF(NOT([Scolarite masquee]), DIVIDE(SUM(FactScolarite[validations]) + SUM(FactScolarite[inconnus]), SUM(FactScolarite[inscrits])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Diplomation",
            "expression": "IF(NOT([Scolarite masquee]), DIVIDE(SUM(FactScolarite[diplomes]), SUM(FactScolarite[eligibles_diplome])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Passage",
            "expression": "IF(NOT([Scolarite masquee]), DIVIDE(SUM(FactScolarite[passages]), SUM(FactScolarite[eligibles_passage])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Redoublement",
            "expression": "IF(NOT([Scolarite masquee]), DIVIDE(SUM(FactScolarite[redoublements]), SUM(FactScolarite[suivis])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Reorientation",
            "expression": "IF(NOT([Scolarite masquee]), DIVIDE(SUM(FactScolarite[reorientations]), SUM(FactScolarite[suivis])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Sortie observee",
            "expression": "IF(NOT([Scolarite masquee]), DIVIDE(SUM(FactScolarite[sorties_observees]), SUM(FactScolarite[suivis])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Situation inconnue",
            "expression": "IF(NOT([Scolarite masquee]), DIVIDE(SUM(FactScolarite[situations_inconnues]), SUM(FactScolarite[suivis])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Fin de formation diplomee",
            "expression": "IF(NOT([Scolarite masquee]), DIVIDE(SUM(FactScolarite[fins_diplomees]), SUM(FactScolarite[suivis])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Evolution",
            "expression": "VAR UnAn = HASONEVALUE(DimAnnee[annee])\nVAR Ordre = SELECTEDVALUE(DimAnnee[ordre])\nVAR Actuel = [Inscrits]\nVAR Precedent = CALCULATE([Inscrits], FILTER(ALL(DimAnnee), DimAnnee[ordre] = Ordre - 1))\nRETURN IF(UnAn && NOT(ISBLANK(Actuel)) && NOT(ISBLANK(Precedent)), DIVIDE(Actuel - Precedent, Precedent), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Participation evaluation",
            "expression": "IF(NOT([Evaluation masquee]), DIVIDE(SUM(FactEvaluation[repondants]), SUM(FactEvaluation[sollicites])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Satisfaction",
            "expression": "IF(NOT([Evaluation masquee]), DIVIDE(SUM(FactEvaluation[satisfaits]), SUM(FactEvaluation[avis])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Couverture avis",
            "expression": "IF(NOT([Evaluation masquee]), DIVIDE(SUM(FactEvaluation[avis]), SUM(FactEvaluation[repondants])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Avis valides",
            "expression": "IF(NOT([Evaluation masquee]), SUM(FactEvaluation[avis]), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "#,0"
          },
          {
            "name": "Eligibles insertion",
            "expression": "IF(NOT([Insertion masquee]), SUM(FactInsertion[eligibles]), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "#,0"
          },
          {
            "name": "Non matures",
            "expression": "IF(NOT([Insertion masquee]), SUM(FactInsertion[non_matures]), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "#,0"
          },
          {
            "name": "Participation insertion",
            "expression": "IF(NOT([Insertion masquee]), DIVIDE(SUM(FactInsertion[repondants]), SUM(FactInsertion[sollicites])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Emploi six mois",
            "expression": "IF(NOT([Insertion masquee]), DIVIDE(SUM(FactInsertion[emploi]), SUM(FactInsertion[situations_connues])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Insertion actifs",
            "expression": "IF(NOT([Insertion masquee]), DIVIDE(SUM(FactInsertion[emploi]), SUM(FactInsertion[actifs])), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Situations connues",
            "expression": "IF(NOT([Insertion masquee]), SUM(FactInsertion[situations_connues]), BLANK())",
            "displayFolder": "Indicateurs",
            "formatString": "#,0"
          },
          {
            "name": "Emploi affichage",
            "expression": "SWITCH(TRUE(), NOT(HASONEVALUE(DimAnnee[annee])), \"Sélectionner une année\", [Insertion masquee], \"Masqué\", SUM(FactInsertion[eligibles]) = 0, \"Non observable\", ISBLANK([Emploi six mois]), \"Non calculable\", FORMAT([Emploi six mois], \"0.0 %\", \"fr-FR\"))",
            "displayFolder": "Indicateurs"
          },
          {
            "name": "Passage affichage",
            "expression": "SWITCH(TRUE(), NOT(HASONEVALUE(DimAnnee[annee])), \"Sélectionner une année\", [Scolarite masquee], \"Masqué\", SUM(FactScolarite[suivis]) = 0, \"Non observable\", ISBLANK([Passage]), \"Non calculable\", FORMAT([Passage], \"0.0 %\", \"fr-FR\"))",
            "displayFolder": "Indicateurs"
          },
          {
            "name": "Reorientation affichage",
            "expression": "SWITCH(TRUE(), NOT(HASONEVALUE(DimAnnee[annee])), \"Sélectionner une année\", [Scolarite masquee], \"Masqué\", SUM(FactScolarite[suivis]) = 0, \"Non observable\", FORMAT([Reorientation], \"0.0 %\", \"fr-FR\"))",
            "displayFolder": "Indicateurs"
          },
          {
            "name": "Sortie affichage",
            "expression": "SWITCH(TRUE(), [Scolarite masquee], \"Masqué\", SUM(FactScolarite[suivis]) = 0, \"Non observable\", FORMAT([Sortie observee], \"0.0 %\", \"fr-FR\"))",
            "displayFolder": "Indicateurs"
          },
          {
            "name": "Inconnus affichage",
            "expression": "SWITCH(TRUE(), [Scolarite masquee], \"Masqué\", SUM(FactScolarite[suivis]) = 0, \"Non observable\", FORMAT([Situation inconnue], \"0.0 %\", \"fr-FR\"))",
            "displayFolder": "Indicateurs"
          },
          {
            "name": "Validation evolution",
            "expression": "VAR AnneeGraph = SELECTEDVALUE(DimAnneeGraph[annee])\nRETURN CALCULATE([Validation eligibles], REMOVEFILTERS(DimAnnee), TREATAS({AnneeGraph}, DimAnnee[annee]))",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          },
          {
            "name": "Effectifs evolution",
            "expression": "VAR AnneeGraph = SELECTEDVALUE(DimAnneeGraph[annee])\nRETURN CALCULATE([Inscrits], REMOVEFILTERS(DimAnnee), TREATAS({AnneeGraph}, DimAnnee[annee]))",
            "displayFolder": "Indicateurs",
            "formatString": "#,0"
          },
          {
            "name": "Satisfaction evolution",
            "expression": "VAR AnneeGraph = SELECTEDVALUE(DimAnneeGraph[annee])\nRETURN CALCULATE([Satisfaction], REMOVEFILTERS(DimAnnee), TREATAS({AnneeGraph}, DimAnnee[annee]))",
            "displayFolder": "Indicateurs",
            "formatString": "0.0%"
          }
        ],
        "partitions": [
          {
            "name": "Indicateurs",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [vide = Int64.Type], {{0}})"
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "FactScolarite_DimFormation",
        "fromTable": "FactScolarite",
        "fromColumn": "formation_id",
        "toTable": "DimFormation",
        "toColumn": "formation_id",
        "crossFilteringBehavior": "oneDirection",
        "fromCardinality": "many",
        "toCardinality": "one"
      },
      {
        "name": "FactScolarite_DimAnnee",
        "fromTable": "FactScolarite",
