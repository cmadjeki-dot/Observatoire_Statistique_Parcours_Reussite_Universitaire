          },
          {
            "name": "censures",
            "dataType": "int64",
            "sourceColumn": "censures",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0"
          },
          {
            "name": "masque",
            "dataType": "boolean",
            "sourceColumn": "masque",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "FactScolarite",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "fxCsv(\"fait_scolarite.csv\", {\"annee\", \"formation_id\", \"masque\"}, true)"
            }
          }
        ]
      },
