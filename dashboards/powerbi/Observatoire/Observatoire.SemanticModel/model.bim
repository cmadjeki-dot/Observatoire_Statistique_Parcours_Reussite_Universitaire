            "dataType": "int64",
            "sourceColumn": "redoublements",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0"
          },
          {
            "name": "reorientations",
            "dataType": "int64",
            "sourceColumn": "reorientations",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0"
          },
          {
            "name": "sorties_observees",
            "dataType": "int64",
            "sourceColumn": "sorties_observees",
            "summarizeBy": "none",
