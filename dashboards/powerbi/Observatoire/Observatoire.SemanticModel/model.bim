            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "FactEvaluation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "fxCsv(\"fait_evaluation.csv\", {\"annee\", \"formation_id\", \"masque\"}, true)"
            }
          }
        ]
      },
      {
        "name": "FactInsertion",
        "columns": [
          {
            "name": "annee",
            "dataType": "string",
            "sourceColumn": "annee",
            "summarizeBy": "none"
          },
          {
            "name": "formation_id",
            "dataType": "string",
            "sourceColumn": "formation_id",
            "summarizeBy": "none"
          },
          {
            "name": "diplomes",
