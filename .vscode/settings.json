{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": {
    "**/.Rproj.user": true,
    "**/.quarto": true,
    "**/_targets": true,
    "**/renv/library": true,
    "**/renv/staging": true
  },
  "search.exclude": {
    "**/renv/**": true,
    "**/_targets/**": true,
    "**/_site/**": true,
    "**/outputs/**": true,
    "**/data/**": true
  }
}
